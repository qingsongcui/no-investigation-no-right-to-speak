{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Design v2.4.0",
  "type": "object",
  "required": ["schema_version", "investigation", "questions"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "investigation": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "question", "research_type", "claim_ids", "outcome_variable", "exposure_variable", "unit_of_analysis", "time_granularity", "population", "required_data", "acceptable_proxies", "unacceptable_substitutes", "confounders", "identification_strategy", "feasible", "fallback_type"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^RQ-[0-9]{2}$"},
          "question": {"type": "string", "minLength": 1},
          "research_type": {"enum": ["descriptive", "measurement", "comparative", "mechanistic", "causal", "predictive"]},
          "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{2,}$"}},
          "outcome_variable": {"type": "string"},
          "exposure_variable": {"type": "string"},
          "unit_of_analysis": {"type": "string", "minLength": 1},
          "time_granularity": {"type": "string", "minLength": 1},
          "population": {"type": "string", "minLength": 1},
          "required_data": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptable_proxies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "unacceptable_substitutes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confounders": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "identification_strategy": {"type": "string", "minLength": 1},
          "feasible": {"type": "boolean"},
          "fallback_type": {"enum": ["descriptive", "measurement", "comparative", "mechanistic", "correlational", "none"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
