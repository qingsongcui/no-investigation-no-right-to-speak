{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report Claim Source Map v2.4.0",
  "type": "object",
  "required": ["schema_version", "investigation", "claims"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "investigation": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["report_claim", "source_ids", "evidence_ids", "locator"],
      "properties": {
        "report_claim": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S-[0-9]{3,}$"}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{2,}$"}},
        "locator": {"type": "string", "minLength": 1},
        "contains_numeric_claim": {"type": "boolean"}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
