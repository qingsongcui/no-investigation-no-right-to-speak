{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adaptive Report Contract v2.4.0",
  "type": "object",
  "required": [
    "schema_version",
    "investigation",
    "overall_status",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "2.4"
    },
    "investigation": {
      "type": "string",
      "minLength": 1
    },
    "overall_status": {
      "enum": [
        "COMPLETE_DESCRIPTIVE",
        "COMPLETE_MECHANISTIC",
        "COMPLETE_CAUSAL",
        "PARTIAL_WITH_BOUNDED_CLAIMS",
        "DATA_ACCESS_REQUIRED",
        "GAP_REPORT"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "heading",
          "authorized_claim_ids",
          "judgment",
          "evidence_or_table",
          "source_ids",
          "dimension_status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^RQ-[0-9]{2}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "authorized_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{2,}$"
            }
          },
          "judgment": {
            "type": "string",
            "minLength": 1
          },
          "evidence_or_table": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "strongest_alternative": {
            "type": "string",
            "minLength": 1
          },
          "falsification_signal": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^S-[0-9]{3,}$"
            }
          },
          "dimension_status": {
            "enum": [
              "complete",
              "bounded",
              "data_access_required",
              "no_standing"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "presentation": {
      "enum": [
        "legacy",
        "natural"
      ]
    }
  },
  "additionalProperties": false
}
