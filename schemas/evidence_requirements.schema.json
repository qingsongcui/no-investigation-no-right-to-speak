{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Requirements v2.4.0",
  "type": "object",
  "required": ["schema_version", "investigation", "requirements"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "investigation": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["requirement_id", "question_ids", "claim_ids", "evidence_type", "description", "critical", "minimum_acceptance", "status"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^ER-[0-9]{2,}$"},
        "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RQ-[0-9]{2}$"}},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{2,}$"}},
        "evidence_type": {"enum": ["definition", "numeric", "behavioral", "mechanism", "causal_identification", "disconfirmation", "context"]},
        "description": {"type": "string", "minLength": 1},
        "critical": {"type": "boolean"},
        "minimum_acceptance": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "met", "unavailable", "access_required"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[0-9]{2,}$"}},
        "information_gain": {"type": "object"}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
