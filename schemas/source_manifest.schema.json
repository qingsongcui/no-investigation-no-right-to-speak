{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Frozen Source Manifest v2.4.0",
  "type": "object",
  "required": ["source_id", "title", "fetched_title", "canonical_url", "publisher", "published_at", "retrieved_at", "access_status", "final_url", "content_fingerprint", "locator", "supports", "evidence_ids"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^S-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "fetched_title": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "pattern": "^https?://"},
    "publisher": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "retrieved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "access_status": {"type": "integer", "minimum": 200, "maximum": 399},
    "final_url": {"type": "string", "pattern": "^https?://"},
    "content_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "locator": {"type": "string", "minLength": 1},
    "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{2,}$"}},
    "original_source_status": {"enum": ["obtained", "not_applicable", "not_obtained"]}
  }, "additionalProperties": false
}
