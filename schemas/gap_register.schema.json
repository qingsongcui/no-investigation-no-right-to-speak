{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gap Register v2.4.0",
  "type": "object",
  "required": ["schema_version", "investigation", "gaps"],
  "properties": {
    "schema_version": {"const": "2.4"},
    "investigation": {"type": "string", "minLength": 1},
    "gaps": {"type": "array", "items": {
      "type": "object",
      "required": ["gap_id", "requirement_ids", "claim_ids", "description", "critical", "attempted_paths", "next_feasible_path", "expected_information_gain", "estimated_cost", "access_mode", "status"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^G-[0-9]{2,}$"},
        "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ER-[0-9]{2,}$"}},
        "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{2,}$"}},
        "description": {"type": "string", "minLength": 1},
        "critical": {"type": "boolean"},
        "attempted_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_feasible_path": {"type": "string"},
        "expected_information_gain": {"type": "string", "minLength": 1},
        "estimated_cost": {"type": "string", "minLength": 1},
        "access_mode": {"enum": ["public", "login", "paid", "user_data", "fieldwork", "none"]},
        "status": {"enum": ["open", "closed", "publicly_unavailable", "access_required", "cost_exceeded"]}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
